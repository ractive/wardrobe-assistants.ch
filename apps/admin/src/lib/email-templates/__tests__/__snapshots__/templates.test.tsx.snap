exports[`bookingAssigned template > renders plaintext snapshot 1`] = `
"ASSIGNED TO SPRING SHOW

Hi Alex,

You've been assigned to Spring Show.

When: Sunday, 1 March 2026
Where: Theatre 1

Notes: Bring black

Open booking in Wardrobe Assistants https://admin.wardrobe-assistants.ch/bookings/abc"
`;

