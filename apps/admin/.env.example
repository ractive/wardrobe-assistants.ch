# Local dev: file-backed libSQL. In production, point to bunny.net libSQL.
# `file:./dev.db` is the supported dev value — the env loader hard-fails at
# boot if NODE_ENV=development is paired with a remote (libsql://… / https://…)
# DATABASE_URL, and vice versa for production.
DATABASE_URL=file:./dev.db
DATABASE_AUTH_TOKEN=

# Better Auth — generate a strong secret with: openssl rand -hex 32
# `npm run db:reset:admin` auto-generates this value into `.env.local` on
# first run, so you don't normally need to set it by hand. The placeholder
# below stays so `.env.example` is self-explanatory and CI/Docker (where
# the var is injected directly) has a documented expected shape.
BETTER_AUTH_SECRET=replace-with-32-byte-hex
BETTER_AUTH_URL=http://localhost:3000

# Resend — transactional email.
# Empty (`RESEND_API_KEY=`) is the supported dev value: the forthcoming
# `mail.ts` wrapper falls back to console-logging emails when this is unset
# in development. Set it to a real key only when you want dev sends to go
# out for real (useful for template / deliverability work).
RESEND_API_KEY=
EMAIL_FROM="Wardrobe Assistants <info@wardrobe-assistants.ch>"

# Used only by `npm -w apps/admin run seed:admin`.
# `npm run db:reset:admin` defaults these to `admin@example.com` /
# `dev-only-not-secure` when unset, so a fresh clone just works. Set them
# here only if you want a different bootstrap admin in dev.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# VAPID keys for Web Push notifications (iter-23 — Admin PWA + Web Push).
# Generate with: npx web-push generate-vapid-keys
# All three are optional in dev — push paths short-circuit (no-op + warn)
# when any are missing. NEXT_PUBLIC_VAPID_PUBLIC_KEY is exposed to the
# browser; keep VAPID_PRIVATE_KEY and VAPID_SUBJECT server-side only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notify@wardrobe-assistants.ch
