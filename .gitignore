# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
**/.next/
apps/homepage/out/

# production
/build

# misc
.DS_Store
*.pem

# obsidian (knowledgebase app local state)
kb/.obsidian/

# editor / IDE
.idea/
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev libSQL/SQLite databases
*.db
*.db-journal
*.db-wal
*.db-shm

# performance reports (Lighthouse, ff-rdp); cross-browser-notes.md is committed
kb/perf-reports/*
!kb/perf-reports/cross-browser-notes.md

# OpenTofu / Terraform — never commit
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup
infra/terraform/*.tfvars
infra/terraform/crash.log
infra/terraform/generated.tf

# Claude Code transient runtime state (lock files, scheduled-task store)
.claude/*.lock
.claude/agent-memory/
.claude/worktrees/
