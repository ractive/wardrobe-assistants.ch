{
  "name": "wardrobe-assistants-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w @wardrobe-assistants/homepage run dev",
    "build": "npm -w @wardrobe-assistants/homepage run build",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lighthouse:homepage": "node scripts/lighthouse.mjs homepage",
    "lighthouse:services": "node scripts/lighthouse.mjs services"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "vite": "^7.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "happy-dom": "^20.9.0",
    "lighthouse": "^13.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
