{
  "name": "wardrobe-assistants-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w @wardrobe-assistants/homepage run dev",
    "dev:admin": "npm -w @wardrobe-assistants/admin run dev",
    "db:reset:admin": "npm -w @wardrobe-assistants/admin run db:reset",
    "build": "npm -w @wardrobe-assistants/homepage run build",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm test",
    "verify:tf": "cd infra/terraform && tofu fmt -check && tofu init -backend=false -input=false -no-color >/dev/null && tofu validate",
    "lighthouse:homepage": "node scripts/lighthouse.mjs homepage",
    "lighthouse:services": "node scripts/lighthouse.mjs services",
    "check:contrast": "node scripts/check-contrast.mjs",
    "smoke:public": "scripts/smoke/proxy-public-paths.sh && scripts/smoke/homepage-catalog-non-empty.sh",
    "smoke:admin-static": "scripts/smoke/admin-static-asset.sh"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "culori": "^4.0.2",
    "happy-dom": "^21.0.4",
    "lighthouse": "^13.6.0",
    "shadcn": "^4.23.0",
    "sharp": "0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
