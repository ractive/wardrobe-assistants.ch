{
  "name": "wardrobe-assistants-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w @wardrobe-assistants/homepage run dev",
    "dev:admin": "npm -w @wardrobe-assistants/admin run dev",
    "db:reset:admin": "npm -w @wardrobe-assistants/admin run db:reset",
    "build": "npm -w @wardrobe-assistants/homepage run build",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm test",
    "verify:tf": "cd infra/terraform && tofu fmt -check && tofu init -backend=false -input=false -no-color >/dev/null && tofu validate",
    "lighthouse:homepage": "node scripts/lighthouse.mjs homepage",
    "lighthouse:services": "node scripts/lighthouse.mjs services"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "happy-dom": "^20.9.0",
    "lighthouse": "^13.2.0",
    "shadcn": "^4.7.0",
    "sharp": "0.34.5",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.6"
  }
}
